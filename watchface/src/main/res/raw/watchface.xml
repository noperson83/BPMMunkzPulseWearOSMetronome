<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <UserConfigurations>
        <ListConfiguration
            id="dial_style"
            displayName="dial_style_label"
            screenReaderText="dial_style_label"
            defaultValue="all_colors">
            <ListOption
                id="all_colors"
                displayName="dial_style_all_colors_label"
                screenReaderText="dial_style_all_colors_label" />
            <ListOption
                id="blue"
                displayName="dial_style_blue_label"
                screenReaderText="dial_style_blue_label" />
            <ListOption
                id="green"
                displayName="dial_style_green_label"
                screenReaderText="dial_style_green_label" />
            <ListOption
                id="orange"
                displayName="dial_style_orange_label"
                screenReaderText="dial_style_orange_label" />
            <ListOption
                id="purple"
                displayName="dial_style_purple_label"
                screenReaderText="dial_style_purple_label" />
            <ListOption
                id="white"
                displayName="dial_style_white_label"
                screenReaderText="dial_style_white_label" />
        </ListConfiguration>
        <ColorConfiguration
            id="hand_color"
            displayName="hand_color_label"
            screenReaderText="hand_color_label"
            defaultValue="0">
            <ColorOption
                id="0"
                displayName="hand_color_green_label"
                screenReaderText="hand_color_green_label"
                colors="#FF76FF03" />
            <ColorOption
                id="1"
                displayName="hand_color_white_label"
                screenReaderText="hand_color_white_label"
                colors="#FFFFFFFF" />
            <ColorOption
                id="2"
                displayName="hand_color_blue_label"
                screenReaderText="hand_color_blue_label"
                colors="#FF39A7FF" />
            <ColorOption
                id="3"
                displayName="hand_color_orange_label"
                screenReaderText="hand_color_orange_label"
                colors="#FFFF8C1A" />
            <ColorOption
                id="4"
                displayName="hand_color_purple_label"
                screenReaderText="hand_color_purple_label"
                colors="#FFB86BFF" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene>
        <ListConfiguration id="dial_style">
            <ListOption id="all_colors">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="dial_all_colors" />
                </PartImage>
            </ListOption>
            <ListOption id="blue">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="dial_blue" />
                </PartImage>
            </ListOption>
            <ListOption id="green">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="dial_green" />
                </PartImage>
            </ListOption>
            <ListOption id="orange">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="dial_orange" />
                </PartImage>
            </ListOption>
            <ListOption id="purple">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="dial_purple" />
                </PartImage>
            </ListOption>
            <ListOption id="white">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="dial_white" />
                </PartImage>
            </ListOption>
        </ListConfiguration>

        <ComplicationSlot
            x="260"
            y="84"
            width="108"
            height="48"
            slotId="1"
            displayName="latest_bpm_slot_label"
            supportedTypes="SHORT_TEXT EMPTY"
            isCustomizable="TRUE">
            <BoundingBox x="0" y="0" width="108" height="48" outlinePadding="4" />
            <DefaultProviderPolicy
                primaryProvider="bpm.munkz.pulse_wear.os.pro/bpm.munkz.pulse_wear.os.bpm.presentation.LatestBpmComplicationDataSourceService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="64" height="48">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font
                            family="SYNC_TO_DEVICE"
                            size="34"
                            weight="BOLD"
                            slant="NORMAL"
                            color="#FF76FF03">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot
            x="136"
            y="84"
            width="108"
            height="48"
            slotId="2"
            displayName="latest_key_slot_label"
            supportedTypes="SHORT_TEXT EMPTY"
            isCustomizable="TRUE">
            <BoundingBox x="0" y="0" width="108" height="48" outlinePadding="4" />
            <DefaultProviderPolicy
                primaryProvider="bpm.munkz.pulse_wear.os.pro/bpm.munkz.pulse_wear.os.bpm.presentation.LatestKeyComplicationDataSourceService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="64" height="48">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font
                            family="SYNC_TO_DEVICE"
                            size="34"
                            weight="BOLD"
                            slant="NORMAL"
                            color="#FFFFFFFF">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <AnalogClock x="0" y="0" width="450" height="450">
            <HourHand
                resource="hour_hand"
                x="213"
                y="75"
                width="24"
                height="170"
                pivotX="0.5"
                pivotY="0.882"
                tintColor="[CONFIGURATION.hand_color.0]" />
            <MinuteHand
                resource="minute_hand"
                x="216"
                y="29"
                width="18"
                height="220"
                pivotX="0.5"
                pivotY="0.891"
                tintColor="[CONFIGURATION.hand_color.0]" />
            <SecondHand
                resource="second_hand"
                x="221"
                y="21"
                width="8"
                height="230"
                pivotX="0.5"
                pivotY="0.887"
                tintColor="[CONFIGURATION.hand_color.0]">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Sweep frequency="15" />
            </SecondHand>
        </AnalogClock>
    </Scene>
</WatchFace>
