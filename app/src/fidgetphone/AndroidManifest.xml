<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />

    <uses-feature
        android:name="android.hardware.type.watch"
        tools:node="remove" />

    <application>
        <activity
            android:name=".presentation.MainActivity"
            tools:remove="android:screenOrientation" />

        <uses-library
            android:name="com.google.android.wearable"
            tools:node="remove" />

        <uses-library
            android:name="wear-sdk"
            tools:node="remove" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            tools:node="remove" />

        <service
            android:name=".presentation.BpmMunkzTileService"
            tools:node="remove" />

        <service
            android:name=".presentation.LatestBpmComplicationDataSourceService"
            tools:node="remove" />

        <service
            android:name=".presentation.LatestKeyComplicationDataSourceService"
            tools:node="remove" />
    </application>
</manifest>
